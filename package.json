{
    "name": "vue-project",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run type-check && npm run build-only",
        "preview": "vite preview",
        "test": "vitest run",
        "build-only": "vite build",
        "postbuild-only": "node scripts/generate-service-worker.mjs",
        "type-check": "vue-tsc --build",
        "lint": "npm run lint:oxlint && npm run lint:eslint",
        "lint:oxlint": "oxlint . --fix",
        "lint:eslint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@tailwindcss/vite": "^4.3.3",
        "@vueuse/core": "^14.4.0",
        "pinia": "^4.0.2",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.40",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "~10.9.2",
        "jiti": "^2.7.0",
        "oxlint": "~1.75.0",
        "prettier": "3.9.5",
        "typescript": "~6.0.0",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.7"
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": false,
        "bracketSpacing": false,
        "printWidth": 100
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
